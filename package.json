{
  "name": "wibetunnel",
  "version": "1.0.0",
  "description": "Terminal web minimalista y portable con sesiones persistentes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "vendor": "node scripts/vendor.js",
    "test:e2e": "bash tests/e2e/run.sh"
  },
  "author": "Javier Eaw <javiereaw@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javiereaw/Wibetunnel.git"
  },
  "homepage": "https://github.com/javiereaw/Wibetunnel#readme",
  "bugs": {
    "url": "https://github.com/javiereaw/Wibetunnel/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "terminal",
    "web-terminal",
    "xterm",
    "socket.io",
    "node-pty",
    "persistent-sessions"
  ],
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "playwright": "^1.61.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
