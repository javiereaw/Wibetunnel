# Instalar en /etc/systemd/system/cloudflared.service
# Requiere cloudflared instalado y un tunnel configurado (~/.cloudflared/).
#   sudo cp deploy/cloudflared.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cloudflared
[Unit]
Description=Cloudflare Tunnel
After=network.target wibetunnel.service

[Service]
Type=simple
User=javiereaw
ExecStart=/usr/local/bin/cloudflared tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
